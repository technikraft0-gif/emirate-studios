        <!-- SERVICES -->
        <section class="services section-wrap section-spacing" id="services">
          <div class="section-kicker">
            <span>03 — WHAT WE DO</span>
            <span>THOUGHTFUL BY DESIGN.</span>
          </div>

          <div class="section-title-row">
            <h2 class="section-heading">
              Creative thinking.<br />
              <span class="muted-heading">Real-world purpose.</span>
            </h2>
            <p class="section-intro">
              A focused set of creative services, shaped around what your
              brand actually needs.
            </p>
          </div>

          <div class="services-list">
            {services.map((service) => (
              <article class="service-row">
                <span class="service-number">{service.number}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <a href="#contact" aria-label={`Ask us about ${service.title}`}>↗</a>
              </article>
            ))}
          </div>
        </section>

        <!-- CASE STUDIES -->
        <section class="case-studies section-wrap section-spacing" id="case-studies">
          <div class="section-kicker">
            <span>04 — BEHIND THE WORK</span>
            <span>THE THINKING MATTERS, TOO.</span>
          </div>

          <div class="section-title-row">
            <h2 class="section-heading">
              From challenge<br />
              <span class="gradient-text">to clarity.</span>
            </h2>
            <p class="section-intro">
              A closer look at the thinking, choices, and creative direction
              behind selected projects.
            </p>
          </div>

          <div class="case-grid">
            {caseStudies.map((study) => (
              <article class={`case-card ${study.className}`}>
                <div class="case-visual">
                  <img src={study.image} alt={`${study.name} case study visual`} loading="lazy" />
                  <span class="case-badge">{study.label}</span>
                  <span class="case-visual-index">{study.number}</span>
                </div>
                <div class="case-content">
                  <div>
                    <span class="micro-label">THE PROJECT</span>
                    <h3>{study.name}</h3>
                  </div>
                  <div>
                    <span class="micro-label">THE DIRECTION</span>
                    <p>{study.description}</p>
                  </div>
                  <div class="case-result">
                    <span class="micro-label">THE FOCUS</span>
                    <strong>{study.result}</strong>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <p class="disclaimer-note">
            These are illustrative portfolio concepts. Replace them with
            verified client projects, original work, and accurate outcomes
            before publishing.
          </p>
        </section>

        <!-- TESTIMONIALS -->
        <section class="reviews section-wrap section-spacing" id="reviews">
          <div class="section-kicker">
            <span>05 — KIND WORDS</span>
            <span>GOOD WORK. GOOD PEOPLE.</span>
          </div>

          <div class="reviews-heading">
            <h2 class="section-heading">
              The best part<br />
              <span class="muted-heading">is the people.</span>
            </h2>
            <div class="review-mark" aria-hidden="true">“</div>
          </div>

          <div class="review-grid">
            <article class="review-card">
              <div class="review-stars" aria-label="Five star placeholder">★★★★★</div>
              <blockquote>
                “This is where your client's words should go. Choose a
