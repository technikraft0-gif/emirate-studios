                    <img src={project.image} alt={`${project.title} visual design inspiration`} loading="lazy" />
                    <div class="project-image-overlay"></div>
                    <span class="project-number">{project.number} / 06</span>
                    <span class="project-arrow" aria-hidden="true">↗</span>
                  </div>
                </a>
                <div class="project-meta">
                  <div>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                  </div>
                  <span class="project-category">{project.category}</span>
                </div>
              </article>
            ))}
          </div>

          <div class="work-bottom">
            <span>GOOD WORK SPEAKS FOR ITSELF.</span>
            <a class="text-link" href="#contact">Have a project in mind? <span aria-hidden="true">↗</span></a>
