---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090f" />
    <meta
      name="description"
      content="Emirate Studios is an independent creative studio building distinctive brands, digital experiences, and visual identities."
    />
    <meta
      name="keywords"
      content="Emirate Studios, graphic design, brand identity, digital design, art direction"
    />
    <meta property="og:title" content="Emirate Studios — Ideas into Identity" />
    <meta
      property="og:description"
      content="We build bold identities and digital experiences for brands with something to say."
    />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Emirate Studios — Ideas into Identity</title>
  </head>

  <body>
    <div class="site-shell">
      <header class="site-header" id="top">
        <a class="brand" href="#top" aria-label="Emirate Studios home">
          <span class="brand-mark" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span class="brand-name">emirate<span>®</span><small>STUDIOS</small></span>
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          <span></span><span></span>
        </button>

        <nav class="navigation" id="primary-navigation" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#work">Selected work</a>
          <a href="#services">Services</a>
          <a href="#reviews">Reviews</a>
          <a class="nav-contact" href="#contact">
            Let's talk <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>

      <main>
        <!-- HERO -->
        <section class="hero section-wrap" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="eyebrow">
              <span class="status-dot"></span>
              INDEPENDENT CREATIVE STUDIO
            </div>

            <h1 id="hero-title">
