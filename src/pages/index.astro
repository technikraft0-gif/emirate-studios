            <button class="filter-button" type="button" data-filter="art-direction" aria-pressed="false">Art direction</button>
            <button class="filter-button" type="button" data-filter="campaign" aria-pressed="false">Campaigns</button>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class={`project-card ${project.className}`} data-category={project.type}>
